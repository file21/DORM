<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="dorm.ui.controller.LoginController"
           styleClass="login-container" stylesheets="@styles.css">

    <VBox alignment="CENTER" spacing="30" styleClass="login-card" maxWidth="400">
        
        <!-- Header -->
        <VBox alignment="CENTER" spacing="8">
            <Label text="DORM" styleClass="login-logo"/>
            <Label text="Student Housing Portal" styleClass="login-subtitle"/>
        </VBox>
        
        <!-- Tab Pane for Login/Register -->
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" styleClass="login-tabs">
            
            <!-- Login Tab -->
            <Tab text="Sign In">
                <VBox spacing="20" styleClass="login-form">
                    
                    <VBox spacing="8">
                        <TextField fx:id="loginUsernameField" promptText="Student ID (e.g., UGR/1234/16)" styleClass="login-field"/>
                        <PasswordField fx:id="loginPasswordField" promptText="Password" styleClass="login-field"/>
                    </VBox>
                    
                    <Button text="Sign In" onAction="#onLogin" maxWidth="Infinity" styleClass="login-button"/>
                    
                    <Label fx:id="loginStatusLabel" styleClass="login-status"/>
                    
                </VBox>
            </Tab>
            
            <!-- Register Tab -->
            <Tab text="Register">
                <ScrollPane fitToWidth="true" styleClass="login-scroll">
                    <VBox spacing="16" styleClass="login-form">
                        
                        <TextField fx:id="registerNameField" promptText="Full Name" styleClass="login-field"/>
                        
                        <VBox spacing="4">
                            <TextField fx:id="registerStudentIdField" promptText="Student ID (UGR/XXXX/YY)" styleClass="login-field"/>
                            <Label text="This will be your username" styleClass="field-hint"/>
                        </VBox>
                        
                        <HBox spacing="12">
                            <ComboBox fx:id="registerGenderBox" promptText="Gender" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="login-combo"/>
                            <ComboBox fx:id="registerCollegeBox" promptText="College" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="login-combo"/>
                        </HBox>
                        
                        <PasswordField fx:id="registerPasswordField" promptText="Password (min 8 characters)" styleClass="login-field"/>
                        
                        <PasswordField fx:id="registerConfirmPasswordField" promptText="Confirm Password" styleClass="login-field"/>
                        
                        <Button text="Create Account" onAction="#onRegister" maxWidth="Infinity" styleClass="login-button"/>
                        
                        <Label fx:id="registerStatusLabel" styleClass="login-status"/>
                        
                    </VBox>
                </ScrollPane>
            </Tab>
            
        </TabPane>
        
    </VBox>
    
</StackPane>
